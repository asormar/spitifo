{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spitifo",
  "version": "0.1.0",
  "identifier": "dev.spitifo.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spitifo",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/spitifo-backend/": "backend/",
      "../../frontend/dist/": "frontend/",
      "../ffmpeg/": "ffmpeg/",
      "../qjs/": "qjs/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
