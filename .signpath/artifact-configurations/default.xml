<?xml version="1.0" encoding="utf-8"?>
<!--
  What SignPath signs in the artifact the release workflow submits: the zip that
  actions/upload-artifact makes around the Windows installer. Adjust the slug
  and the paths here, not in the workflow, if the installer is renamed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Spitifo-*-windows-x64-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
