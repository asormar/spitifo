.venv/
__pycache__/
*.pyc
node_modules/
frontend/dist/
library/
server.log
probe_*.py
.env

# Indice local de CodeGraph (generado)
.codegraph/

# Registro de skills que genera `gentle-ai skill-registry refresh`
.atl/

# Desktop app build outputs
desktop/node_modules/
desktop/ffmpeg/
desktop/.cache/
desktop/sidecar/build/
desktop/sidecar/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Android app build outputs and machine-specific files
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/*.jks
android/*.keystore

# Provider benchmark output (python -m backend.app.cloud.bench --json)
bench-*.json

# Secretos del cliente OAuth. Google marca como publico el secret de un cliente
# de escritorio (con PKCE), pero igual se mantiene fuera del repositorio: el
# build de release escribe este archivo desde los secretos de CI. El formato y
# los valores de ejemplo estan en oauth_clients.example.json.
backend/app/cloud/oauth_clients.json
